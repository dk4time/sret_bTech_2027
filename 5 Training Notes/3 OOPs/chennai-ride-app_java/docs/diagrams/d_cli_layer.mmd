    class ChennaiWorld {
        <<final>>
    }
    class NotificationLog
    class Customer
    class Captain

    Menu <|-- StartupMenu
    Menu <|-- MainMenu
    Menu <|-- CustomerMenu : inheritance – hierarchical, all six screens
    Menu <|-- CaptainMenu
    Menu <|-- OperationsMenu
    Menu <|-- ClockMenu
    Menu --> "1" ConsoleIO : association – shared io
    Menu --> "0..1" CliSession : association – null in start-up menu
    MainMenu ..> Menu : polymorphism – next.run()
    StartupMenu ..> CliSession : dependency – creates a fresh session
    CliSession "1" *-- "1" ChennaiWorld : composition – owns the seeded world
    CliSession "1" *-- "1" NotificationLog : composition
    CliSession --> ConsoleIO : association
    CustomerMenu --> "1" Customer : association – selected customer
    CaptainMenu --> "1" Captain : association – selected captain
    RuntimeException <|-- GoBackException : inheritance – unchecked
    RuntimeException <|-- QuitException : inheritance – unchecked
    ConsoleIO ..> GoBackException : dependency – throws on b
    ConsoleIO ..> QuitException : dependency – throws on q or EOF
    Launcher ..> StartupMenu : dependency – starts
    Launcher ..> ConsoleIO : dependency – creates
