classDiagram
    direction TB

    class Menu {
        <<abstract>>
        #String title
        #ConsoleIO io
        #CliSession session
        #Menu(String title, ConsoleIO io, CliSession session)
        #options()* String[] «abstract»
        #handle(int choice)* void «abstract»
        #onEnter() boolean
        #subtitle() String
        #exitLabel() String
        +run() void
    }
    note for Menu "run() is final: the loop is written once.<br>Subclasses fill in options() and handle().<br>RideHailingException is caught here, shown as one ✘ line."

    class StartupMenu {
        +StartupMenu(ConsoleIO io)
        #options() String[]
        #exitLabel() String
