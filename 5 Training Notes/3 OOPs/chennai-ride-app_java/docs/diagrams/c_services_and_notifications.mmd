    }

    class DispatchMode {
        <<enumeration>>
        AUTOMATIC
        CAPTAIN_APP
        -String label
    }

    class SimulatedClock {
        <<final>>
        -LocalDateTime now
        +now() LocalDateTime
        +advanceMinutes(long minutes) void
        +advanceTo(LocalDateTime target) void
        +stamp() String
    }

    class Notifier {
        <<interface>>
        +notify(User, RideEvent, String)* void
        +handles(RideEvent event) boolean
    }

    class SmsNotifier {
        -SimulatedClock clock
        -NotificationLog log
        +SmsNotifier(SimulatedClock clock)
        +SmsNotifier(SimulatedClock clock, NotificationLog log)
        +handles(RideEvent event) boolean
        +notify(User, RideEvent, String) void
    }

    class PushNotifier {
        -SimulatedClock clock
        -NotificationLog log
        +PushNotifier(SimulatedClock clock)
        +PushNotifier(SimulatedClock clock, NotificationLog log)
        +notify(User, RideEvent, String) void
    }

    class NotificationLog {
        -List~Entry~ entries
        +record(LocalDateTime, String, User, RideEvent, String) void
        +latestFirst() List~Entry~
    }

    class RideEvent {
        <<enumeration>>
        RIDE_BOOKED
        RIDE_OFFERED
        CAPTAIN_ASSIGNED
        RIDE_COMPLETED
        PAYMENT_FAILED
        RIDE_CANCELLED
        ...
        -boolean important
    }

    class Ride
    class Captain
    class Customer
    class Vehicle
    class Payable
    class ServiceArea

    RideService --> MatchingService : association – finds captains
    RideService --> FareService : association – prices trips
    RideService --> PaymentService : association – collects money
    RideService --> SimulatedClock : association – all time
    RideService --> DispatchMode : association – Auto / Manual
    RideService o-- "*" Notifier : aggregation – dynamic dispatch
    RideService o-- "*" Ride : aggregation – all rides
    MatchingService --> CaptainService : association
    MatchingService --> FareService : association – ETA
    MatchingService ..> Captain : dependency – ranks nearest
    FareService "1" *-- "4" Vehicle : composition – rate card (upcast)
    FareService --> ServiceArea : association – peak and hotspots
    PaymentService --> EarningsService : association
    PaymentService ..> Payable : dependency – creates (upcasting)
    EarningsService "1" *-- "*" DayEarnings : composition – nested class
    CaptainService o-- "*" Captain : aggregation – the fleet
    CustomerService o-- "*" Customer : aggregation
    RatingService --> CaptainService : association
    RatingService ..> Ride : dependency – COMPLETED only
    RideAutopilot --> RideService : association – plain service calls
    RideAutopilot o-- "*" Ride : aggregation
    Notifier <|.. SmsNotifier : interface realisation
    Notifier <|.. PushNotifier : interface realisation
    Notifier ..> RideEvent : dependency
    SmsNotifier o-- "0..1" NotificationLog : aggregation – optional log
    PushNotifier o-- "0..1" NotificationLog : aggregation – optional log
