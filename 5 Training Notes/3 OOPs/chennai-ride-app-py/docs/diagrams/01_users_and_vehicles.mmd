        +EARTH_RADIUS_KM: float$
        +ROAD_FACTOR: float$
        #_name: str
        #_latitude: float
        #_longitude: float
        +from_place_name(place_name: str) Location$
        +haversine_km(lat1: float, lon1: float, lat2: float, lon2: float) float$
        +name() str
        +distance_to(other: Location) float
        +road_distance_to(other: Location) float
        +is_within_km(other: Location, radius_km: float) bool
        +point_towards(destination: Location, fraction: float, name: str) Location
        +#95;#95;setattr#95;#95;(name: str, value: object) None
        +#95;#95;eq#95;#95;(other: object) bool
        +#95;#95;hash#95;#95;() int
