    class Money {
        <<value object>>
        +CURRENCY_SYMBOL: str$
        #_PAISA: Decimal$
        #_amount: Decimal
        +Money(amount: Decimal)
        +zero() Money$
        +total(amounts: list~Money~) Money$
        +amount() Decimal
        +#95;#95;add#95;#95;(other: Money) Money
        +#95;#95;sub#95;#95;(other: Money) Money
        +#95;#95;mul#95;#95;(factor: Decimal) Money
        +#95;#95;lt#95;#95;(other: Money) bool
        +#95;#95;le#95;#95;(other: Money) bool
        +#95;#95;eq#95;#95;(other: object) bool
        +#95;#95;hash#95;#95;() int
        +#95;#95;setattr#95;#95;(name: str, value: object) None
        +percent(rate: Decimal) Money
    }

    User <|-- Customer : inheritance – hierarchical
    User <|-- Captain : inheritance – hierarchical
    Vehicle <|-- Bike : inheritance – hierarchical
    Vehicle <|-- Auto : inheritance – hierarchical
    Vehicle <|-- Cab : inheritance – multilevel (level 2)
    Cab <|-- CabEconomy : inheritance – multilevel (level 3)
    Cab <|-- CabPremium : inheritance – multilevel (level 3)

    Captain "1" *-- "1" Vehicle : composition – HAS-A, created with the captain
    Customer "1" *-- "0..*" PendingFee : composition – owns its unpaid fees
    PendingFee "0..*" --> "0..1" Captain : association – fee is paid to
    Captain "1" --> "1" CaptainStatus : association – enum state
    User "0..*" --> "1" Location : association – is currently at
    Customer "1" --> "1" Money : association – wallet (value object)
    Vehicle ..> VehicleType : dependency – polymorphic vehicle_type()
    Vehicle ..> Money : dependency – rates are Money

    note for Vehicle "calculate_base_fare() is written ONCE here.<br>It calls the abstract rates, so a Bike and a CabPremium<br>give different fares: polymorphism."
    note for Money "Immutable: #95;#95;setattr#95;#95; always raises.<br>Operator overloading: fare + gst, rate * km."

