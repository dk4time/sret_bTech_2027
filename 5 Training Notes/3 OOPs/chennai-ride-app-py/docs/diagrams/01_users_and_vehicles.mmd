%% (a) Users and vehicles — generated from ridehailing/model/user/*, model/vehicle/*, model/common/*
%% Notation: + public, # protected (_name), - private (__name). getters (@property) are shown as name().
%% Trailing * = abstract (italic), trailing $ = class-level: class attribute, @staticmethod or @classmethod (underlined).
classDiagram
    direction TB

    class User {
        <<abstract>>
        #_id_counter: int$
        #_PHONE_PATTERN: Pattern$
        #_user_id: str
        #_name: str
        #_phone: str
        #_location: Location
        #_ratings: list~int~
        +User(name: str, phone: str, location: Location)
        +role() str*
        +id_prefix() str*
        +user_id() str
        +name() str
        +phone() str
        +location() Location
        +rating_count() int
        +average_rating() Decimal
        +receive_rating(score: int) None
        +#95;#95;eq#95;#95;(other: object) bool
        +#95;#95;hash#95;#95;() int
    }

    class Customer {
