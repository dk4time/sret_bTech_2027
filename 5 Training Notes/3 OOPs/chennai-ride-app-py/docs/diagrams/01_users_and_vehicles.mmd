        #_used_coupons: set~str~
        #_location_since: datetime
        +Customer(name: str, phone: str, location: Location, wallet_balance: Money, joined_at: datetime)
        +role() str
        +id_prefix() str
        +wallet_balance() Money
        +ride_history() tuple~Ride~
        +last_completed_ride() Optional~Ride~
        +pending_fee_total() Money
        +top_up(amount: Money) None
        +pay_from_wallet(amount: Money) None
        +ensure_can_book() None
        +begin_ride(ride: Ride) None
        +finish_ride(ride: Ride, drop: Location, at: datetime) None
        +ride_cancelled(ride: Ride) None
        +relocate_to(place: Location, at: datetime) None
        +add_pending_fee(fee: PendingFee) None
        +take_pending_fees() list~PendingFee~
        +mark_coupon_used(code: str) None
