        +FareReceipt(ride_id: str, vehicle_type: VehicleType, base_fare: Money, ... keyword-only)
        +fare_before_gst() Money
        +ride_fare_before_gst() Money
        +gst() Money
        +total() Money
        +#95;#95;str#95;#95;() str
    }

    class RideStatus {
        <<enumeration>>
        REQUESTED
        CAPTAIN_ASSIGNED
        CAPTAIN_ARRIVED
        IN_PROGRESS
        PAYMENT_PENDING
        COMPLETED
        CANCELLED
        +label: str
        +is_active() bool
        +is_cancellable() bool
        +is_final() bool
    }

    class CancellationReason {
        <<enumeration>>
        CUSTOMER_CANCELLED
        NO_SHOW
        OTP_FAILED
        NO_CAPTAIN_AVAILABLE
        +description: str
        +fee_may_apply: bool
    }

    class PaymentStatus {
        <<enumeration>>
        NOT_DUE
        FAILED
        PAID
        +label: str
    }

    class Payable {
        <<interface>>
        +method_name() str*
        +pay(amount: Money) str*
        +is_cash() bool
        +#95;#95;str#95;#95;() str
    }

    class UpiPayment {
        #_reference_counter: int$
        #_upi_id: str
        #_rng: Random
        #_failure_rate: float
        +UpiPayment(upi_id: str, rng: Random, failure_rate: float)
        +upi_id() str
        +method_name() str
        +pay(amount: Money) str
    }

    class CashPayment {
        #_reference_counter: int$
        +method_name() str
        +is_cash() bool
        +pay(amount: Money) str
    }

    class WalletPayment {
        #_reference_counter: int$
        #_customer: Customer
        +WalletPayment(customer: Customer)
        +method_name() str
        +pay(amount: Money) str
    }

    class Customer {
        see diagram (a)
    }
    class Captain {
        see diagram (a)
    }
    class User {
        <<abstract>>
        see diagram (a)
    }
    class PendingFee {
        see diagram (a)
    }

    Ride "1" *-- "1" RideRequest : composition – frozen booking details
    Ride "1" *-- "1" FareEstimate : composition – price shown before confirming
    Ride "1" *-- "0..1" FareReceipt : composition – the itemised bill
    Ride "0..*" o-- "1" Customer : aggregation – existing customer (via request.customer)
    Ride "0..*" o-- "0..1" Captain : aggregation – existing captain, assigned later
    Ride "0..*" --> "1" Payable : association – chosen payment method
    Ride "1" --> "0..*" PendingFee : association – old fees billed on this ride
    Ride --> RideStatus : association – guarded state (no setter)
    Ride --> PaymentStatus : association
    Ride --> CancellationReason : association
    Ride ..> User : dependency – otp_for(user), cancelled_by

    Payable <|.. UpiPayment : realisation – implements pay()
    Payable <|.. CashPayment : realisation – implements pay(), overrides is_cash
    Payable <|.. WalletPayment : realisation – implements pay()
    WalletPayment "0..*" --> "1" Customer : association – pays from this wallet

    note for Ride "#95;#95;otp is name-mangled to _Ride#95;#95;otp:<br>ride.#95;#95;otp from outside raises AttributeError.<br>status changes only via assign_captain(), start(otp), cancel()..."
    note for Payable "Python has no 'interface' keyword:<br>Payable is an ABC used as an interface.<br>PaymentService just calls payable.pay(amount)."

