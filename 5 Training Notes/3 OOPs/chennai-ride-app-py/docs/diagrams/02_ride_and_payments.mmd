        +pickup() Location
        +drop() Location
        +vehicle_type() VehicleType
        +passengers() int
        +coupon_code() Optional~str~
    }

    class FareEstimate {
        #_vehicle_type: VehicleType
        #_distance_km: Decimal
        #_trip_minutes: int
        #_surge_multiplier: Decimal
        #_fare: Money
        #_nearest_captain_eta: Optional~int~
        +fare() Money
        +surge_multiplier() Decimal
        +nearest_captain_eta() Optional~int~
        +is_available() bool
    }

    class FareReceipt {
        +GST_RATE: Decimal$
        #_ride_id: str
        #_base_fare: Money
        #_distance_charge: Money
        #_time_charge: Money
        #_minimum_fare_top_up: Money
        #_waiting_charge: Money
        #_surge_charge: Money
        #_night_charge: Money
